# Copy this file to .env and fill in real values. Never commit .env.

# Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# Create at https://github.com/settings/tokens (fine-grained, public repo read-only).
GITHUB_TOKEN=

# LLM provider. Create at https://console.groq.com/keys
GROQ_API_KEY=
